{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "linux": {
                "problemMatcher": [
                    "$gcc"
                ]
            },
            "osx": {
                "problemMatcher": [
                    "$gcc"
                ]
            }
        },
        {
            "label": "CMake: run (debug)",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/bin/who-am-i-fighting",
            "dependsOn": "CMake: build (debug)",
            "problemMatcher": [],
            "windows": {
                "command": "${workspaceFolder}/build/debug/bin/who-am-i-fighting.exe"
            }
        }
    ]
}
