{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (CMake)",
            "type": "cppdbg",
            "request": "launch",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "preLaunchTask": "CMake: build (debug)",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}/build/debug/bin/who-am-i-fighting.exe",
                "console": "integratedTerminal"
            },
            "linux": {
                "program": "${workspaceFolder}/build/debug/bin/who-am-i-fighting",
                "externalConsole": false,
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            "osx": {
                "program": "${workspaceFolder}/build/debug/bin/who-am-i-fighting",
                "externalConsole": false,
                "MIMode": "lldb"
            }
        }
    ]
}
